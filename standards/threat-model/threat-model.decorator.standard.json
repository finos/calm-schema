{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://calm.finos.org/standards/threat-model/1.0/threat-model.decorator.standard.json",
    "title": "CALM Threat Model Decorator Standard",
    "description": "Records one threat model on one CALM flow: the trust boundaries it crosses, the threats to its nodes and relationships, and the controls that mitigate them. Method-neutral. A method standard, such as STRIDE, extends this one. Extends the base CALM decorator.",
    "allOf": [
        {
            "$ref": "https://calm.finos.org/release/1.3/meta/decorators.json#/defs/decorator"
        },
        {
            "type": "object",
            "properties": {
                "type": {
                    "const": "threat-model",
                    "description": "Must be 'threat-model' for threat model decorators"
                },
                "target-type": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "architecture"
                        ]
                    },
                    "description": "Threat model decorators target the architecture that holds the flow in its flows."
                },
                "data": {
                    "type": "object",
                    "properties": {
                        "flow": {
                            "type": "string",
                            "minLength": 1,
                            "description": "unique-id of the flow that the threat model assesses, in the flows of the target architecture"
                        },
                        "methodology": {
                            "type": "string",
                            "minLength": 1,
                            "description": "The threat modelling method, such as STRIDE, PASTA, LINDDUN or the method of a firm"
                        },
                        "assessed-on": {
                            "type": "string",
                            "format": "date",
                            "description": "Date of the assessment"
                        },
                        "assessor": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Person or team that did the assessment"
                        },
                        "trust-boundaries": {
                            "type": "array",
                            "minItems": 1,
                            "description": "Places where the level of trust changes",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "unique-id": {
                                        "type": "string",
                                        "minLength": 1,
                                        "description": "Identifier of the boundary, unique in this decorator"
                                    },
                                    "name": {
                                        "type": "string",
                                        "minLength": 1,
                                        "description": "Name of the boundary, such as 'Internet to DMZ'"
                                    },
                                    "description": {
                                        "type": "string",
                                        "minLength": 1,
                                        "description": "What changes in trust at the boundary"
                                    },
                                    "elements": {
                                        "$ref": "#/$defs/ids",
                                        "description": "unique-ids of the nodes and relationships that the boundary marks. For a node that holds other nodes, a tool reads its deployed-in and composed-of relationships"
                                    }
                                },
                                "required": [
                                    "unique-id",
                                    "name",
                                    "elements"
                                ],
                                "additionalProperties": true
                            }
                        },
                        "threats": {
                            "type": "array",
                            "description": "The threats found. An empty array records that the flow was assessed and no threat was found",
                            "items": {
                                "$ref": "#/$defs/threat"
                            }
                        }
                    },
                    "required": [
                        "flow",
                        "methodology",
                        "assessed-on",
                        "threats"
                    ],
                    "additionalProperties": true
                }
            },
            "required": [
                "type",
                "target-type",
                "data"
            ]
        }
    ],
    "$defs": {
        "ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "rating": {
            "type": "string",
            "enum": [
                "low",
                "medium",
                "high",
                "critical"
            ]
        },
        "threat": {
            "type": "object",
            "properties": {
                "unique-id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Identifier of the threat, unique in this decorator"
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "classification": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Categories of the threat, from any taxonomy. A method standard can require some of them",
                    "items": {
                        "type": "object",
                        "properties": {
                            "scheme": {
                                "type": "string",
                                "minLength": 1,
                                "description": "The taxonomy, such as STRIDE, CWE, MITRE-ATTACK, MITRE-ATLAS or OWASP-API"
                            },
                            "value": {
                                "type": "string",
                                "minLength": 1,
                                "description": "The category or identifier in that taxonomy"
                            },
                            "reference": {
                                "type": "string",
                                "format": "uri",
                                "description": "Where the category is defined"
                            }
                        },
                        "required": [
                            "scheme",
                            "value"
                        ],
                        "additionalProperties": true
                    }
                },
                "applies-to": {
                    "$ref": "#/$defs/ids",
                    "description": "unique-ids of the nodes and relationships that the threat applies to"
                },
                "sequence-numbers": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "integer"
                    },
                    "description": "Sequence numbers of the transitions of the flow that the threat applies to. With none, the threat applies to every transition of its relationships"
                },
                "likelihood": {
                    "$ref": "#/$defs/rating"
                },
                "impact": {
                    "$ref": "#/$defs/rating"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "identified",
                        "mitigated",
                        "partially-mitigated",
                        "accepted",
                        "transferred",
                        "not-applicable"
                    ],
                    "description": "How the threat is treated"
                },
                "justification": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Why the status is correct. Required for accepted, transferred and not-applicable"
                },
                "mitigations": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "control": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Key of a control in the target architecture. A key that is declared nowhere is a gap, not an error"
                            },
                            "attached-to": {
                                "type": "string",
                                "minLength": 1,
                                "description": "unique-id of the node or relationship that carries the control. With none, the control is on the architecture, or a tool searches for it"
                            },
                            "state": {
                                "type": "string",
                                "enum": [
                                    "planned",
                                    "implemented",
                                    "verified"
                                ]
                            },
                            "note": {
                                "type": "string",
                                "minLength": 1
                            },
                            "evidence": {
                                "type": "array",
                                "minItems": 1,
                                "uniqueItems": true,
                                "items": {
                                    "type": "string",
                                    "format": "uri-reference",
                                    "minLength": 1
                                },
                                "description": "Where the evidence that the control works is kept, such as a control-evaluation decorator or a report"
                            }
                        },
                        "required": [
                            "control",
                            "state"
                        ],
                        "additionalProperties": true
                    }
                },
                "residual-risk": {
                    "type": "object",
                    "properties": {
                        "rating": {
                            "$ref": "#/$defs/rating"
                        },
                        "accepted-by": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Person or role that owns the decision. Required for accepted and transferred"
                        },
                        "review-by": {
                            "type": "string",
                            "format": "date",
                            "description": "Date by which the decision must be reviewed"
                        }
                    },
                    "required": [
                        "rating"
                    ],
                    "additionalProperties": true
                }
            },
            "required": [
                "unique-id",
                "name",
                "applies-to",
                "status"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "status": {
                                "enum": [
                                    "mitigated",
                                    "partially-mitigated"
                                ]
                            }
                        },
                        "required": [
                            "status"
                        ]
                    },
                    "then": {
                        "properties": {
                            "mitigations": {
                                "minItems": 1
                            }
                        },
                        "required": [
                            "mitigations"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "status": {
                                "const": "mitigated"
                            }
                        },
                        "required": [
                            "status"
                        ]
                    },
                    "then": {
                        "properties": {
                            "mitigations": {
                                "contains": {
                                    "properties": {
                                        "state": {
                                            "enum": [
                                                "implemented",
                                                "verified"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "state"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "status": {
                                "enum": [
                                    "accepted",
                                    "transferred"
                                ]
                            }
                        },
                        "required": [
                            "status"
                        ]
                    },
                    "then": {
                        "properties": {
                            "residual-risk": {
                                "required": [
                                    "rating",
                                    "accepted-by"
                                ]
                            }
                        },
                        "required": [
                            "residual-risk"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "status": {
                                "enum": [
                                    "accepted",
                                    "transferred",
                                    "not-applicable"
                                ]
                            }
                        },
                        "required": [
                            "status"
                        ]
                    },
                    "then": {
                        "required": [
                            "justification"
                        ]
                    }
                }
            ],
            "additionalProperties": true
        }
    }
}
